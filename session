365. fn parse_struct_type(definition: &str) -> Result<StructType> {
366.     if !definition.ends_with('}') {
367.         bail!("Struct type {} is missing a closing brace", definition);
368.     }
369.     let inner = &definition[1..definition.len() - 1];
370.     let field_types = split_top_level(inner, ',')?
371.         .into_iter()
372.         .map(parse_arg_type)
373.         .collect::<Result<Vec<_>>>()?;
374.     StructType::new(field_types)
375. }
376. 
377. fn parse_length_def(qualifier: Option<&str>) -> Result<LengthDef> {
378.     if let Some(qual) = qualifier {
379.         if let Some(rest) = qual.strip_prefix("arg") {
380.             return Ok(LengthDef::Arg(rest.parse()?));
381.         }
382.         return Ok(LengthDef::Fixed(qual.parse()?));
383.     }
384.     Ok(LengthDef::None)
385. }
386. 
387. fn split_top_level(input: &str, separator: char) -> Result<Vec<&str>> {
388.     let trimmed = input.trim();
389.     if trimmed.is_empty() {
390.         return Ok(Vec::new());
391.     }
392. 
393.     let mut parts = Vec::new();
394.     let mut depth = 0usize;
395.     let mut start = 0usize;
396. 
397.     for (idx, ch) in input.char_indices() {
398.         match ch {
399.             '{' => depth += 1,
400.             '}' => {
401.                 if depth == 0 {
402.                     bail!("Unmatched closing brace in {}", input);
403.                 }
404.                 depth -= 1;
405.             }
406.             _ if ch == separator && depth == 0 => {
407.                 parts.push(input[start..idx].trim());
408.                 start = idx + ch.len_utf8();
409.             }
410.             _ => {}
411.         }
412.     }
413. 
414.     if depth != 0 {
415.         bail!("Unclosed struct type in {}", input);
416.     }
417. 
418.     parts.push(input[start..].trim());
419.     Ok(parts)
420. }
