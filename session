391. ### Rust integration
392. 
393. The interpreter registers external functions at `DEF XFN` time and calls them via `FuncDef::prep` / `push_arg` / `push_mut_arg`:
394. 
395. ```rust
396. use dyncall::{ArgType, ArgVal, FuncDef};
397. 
398. // At DEF XFN time: parse the descriptor and store the FuncDef
399. let fdef = DynCaller::define_function_by_str(defstr).unwrap();
400. interpreter.external_functions.insert(name, fdef);
401. 
402. // At call time: marshal BASIC values into the invocation
403. let mut invoke = fdef.prep();
404. for (i, arg_value) in arg_values.into_iter().enumerate() {
405.     if let ArgType::Pointer(_) = fdef.get_arg_type(i) {
406.         invoke.push_mut_arg(&mut out_num_buffer);   // output numeric
407.     } else if let ArgType::OCString(_) = fdef.get_arg_type(i) {
408.         invoke.push_mut_arg(&mut out_string_buffer); // output string
409.     } else {
410.         match arg_value {
411.             Value::Number(n) => invoke.push_arg(&(n as i64)).unwrap(),
412.             Value::String(s) => invoke.push_arg(&s).unwrap(),
413.         }
414.     }
415. }
416. let ret = invoke.call();
417. ```
418. 
419. After the call, updated output buffers are written back to BASIC variables automatically.
420. 
