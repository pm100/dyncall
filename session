335. fn parse_arg_type(at: &str) -> Result<ArgType> {
336.     let at = at.trim();
337.     if let Some(rest) = at.strip_prefix('*') {
338.         return Ok(ArgType::Pointer(Box::new(parse_arg_type(rest)?)));
339.     }
340.     if at.starts_with('{') {
341.         return Ok(ArgType::Struct(parse_struct_type(at)?));
342.     }
343. 
344.     let (parsed_arg, qualifier) = parse_def(at);
345.     Ok(match parsed_arg.trim() {
346.         "u8" | "i8" => ArgType::Char,
347.         "u16" => ArgType::U16,
348.         "i16" => ArgType::I16,
349.         "u32" => ArgType::U32,
350.         "i32" => ArgType::I32,
351.         "u64" => ArgType::U64,
352.         "i64" => ArgType::I64,
353.         "f32" => ArgType::F32,
354.         "f64" => ArgType::F64,
355.         "ptr" => ArgType::OpaquePointer,
356.         "cstr" => ArgType::CString,
357.         "ocstr" => ArgType::OCString(parse_length_def(qualifier)?),
358.         "obuff" => ArgType::OByteBuffer(parse_length_def(qualifier)?),
359.         "buff" => ArgType::ByteBuffer,
360.         "void" => ArgType::Void,
361.         _ => bail!("unknown type {}", at),
362.     })
363. }
