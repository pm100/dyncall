369. fn parse_length_def(qualifier: Option<&str>) -> Result<LengthDef> {
370.     if let Some(qual) = qualifier {
371.         if let Some(rest) = qual.strip_prefix("arg") {
372.             return Ok(LengthDef::Arg(rest.parse()?));
373.         }
374.         return Ok(LengthDef::Fixed(qual.parse()?));
375.     }
376.     Ok(LengthDef::None)
377. }
378. 
379. fn split_top_level(input: &str, separator: char) -> Result<Vec<&str>> {
380.     let trimmed = input.trim();
381.     if trimmed.is_empty() {
382.         return Ok(Vec::new());
383.     }
384. 
385.     let mut parts = Vec::new();
386.     let mut depth = 0usize;
387.     let mut start = 0usize;
388. 
389.     for (idx, ch) in input.char_indices() {
390.         match ch {
391.             '{' => depth += 1,
392.             '}' => {
393.                 if depth == 0 {
394.                     bail!("Unmatched closing brace in {}", input);
395.                 }
396.                 depth -= 1;
397.             }
398.             _ if ch == separator && depth == 0 => {
399.                 parts.push(input[start..idx].trim());
400.                 start = idx + ch.len_utf8();
401.             }
402.             _ => {}
403.         }
404.     }
405. 
406.     if depth != 0 {
407.         bail!("Unclosed struct type in {}", input);
408.     }
409. 
410.     parts.push(input[start..].trim());
411.     Ok(parts)
412. }
