358.     if !definition.ends_with('}') {
359.         bail!("Struct type {} is missing a closing brace", definition);
360.     }
361.     let inner = &definition[1..definition.len() - 1];
362.     let field_types = split_top_level(inner, ',')?
363.         .into_iter()
364.         .map(parse_arg_type)
365.         .collect::<Result<Vec<_>>>()?;
366.     StructType::new(field_types)
