1. //! # dyncall
2. //!
3. //! `dyncall` is a crate for calling functions in dynamic libraries at runtime,
4. //! without needing compile-time knowledge of their signatures. It wraps
5. //! [`libffi`](https://sourceware.org/libffi/) to prepare call interfaces and
6. //! marshal arguments, including output (pointer) arguments written to by the
7. //! callee.
8. //!
9. //! ## Workflow
10. //!
11. //! 1. Define a function using a descriptor string with [`DynCaller::define_function_by_str`].
12. //! 2. Prepare an [`Invocation`] from the [`FuncDef`] via [`FuncDef::prep`].
13. //! 3. Push arguments with [`Invocation::push_arg`] (input) or [`Invocation::push_mut_arg`] (output).
14. //! 4. Call with [`Invocation::call`] or [`Invocation::call_and_return`].
15. //!
16. //! ## Function descriptor format
17. //!
18. //! ```text
19. //! "library|function|arg1,arg2,...|return_type|flags"
20. //! ```
21. //!
22. //! ### Type tokens
23. //!
24. //! | Token           | Rust / C type                                      |
25. //! |-----------------|----------------------------------------------------|
26. //! | `i8`, `u8`      | `int8_t` / `uint8_t`                               |
27. //! | `i16`, `u16`    | `int16_t` / `uint16_t`                             |
28. //! | `i32`, `u32`    | `int32_t` / `uint32_t`                             |
29. //! | `i64`, `u64`    | `int64_t` / `uint64_t`                             |
30. //! | `f32`, `f64`    | `float` / `double`                                 |
31. //! | `ptr`           | opaque `void *`                                    |
32. //! | `cstr`          | input `const char *` (null-terminated)             |
33. //! | `ocstr[=N\|=argK]` | output `char *` buffer; size fixed or from arg K|
34. //! | `obuff[=N\|=argK]` | output raw byte buffer; size fixed or from arg K|
35. //! | `*T`            | output pointer `T *` (e.g. `*i32`, `*f64`)        |
36. //! | `{T1,T2,...}`   | flat struct passed by value                        |
37. //! | `*{T1,T2,...}`  | pointer to a flat struct                           |
38. //! | `void`          | no return value                                    |
39. //!
40. //! ### Flags
41. //!
42. //! | Flag          | Meaning                                              |
43. //! |---------------|------------------------------------------------------|
44. //! | `fixargs=N`   | Variadic function with `N` fixed arguments           |
45. //! | `coerce`      | Enable automatic type coercion when pushing arguments|
46. //! | `errno`       | Capture platform error after the call; read via [`Invocation::last_errno`]|
47. //!
48. //! ## Example
49. //!
50. //! ```no_run
51. //! use dyncall::DynCaller;
52. //!
53. //! // Call atoi("42") from the system C library
54. //! #[cfg(target_os = "windows")] const LIBC: &str = "msvcrt.dll";
55. //! #[cfg(target_os = "macos")]   const LIBC: &str = "libSystem.B.dylib";
56. //! #[cfg(target_os = "linux")]   const LIBC: &str = "libc.so.6";
57. //!
58. //! let def = DynCaller::define_function_by_str(&format!("{LIBC}|atoi|cstr|i32|")).unwrap();
59. //! let mut inv = def.prep();
60. //! inv.push_arg(&"42".to_string()).unwrap();
61. //! let result = inv.call();
62. //! assert_eq!(*result.as_i32().unwrap(), 42);
63. //! ```
64. //!
65. //! ## Error capture (`errno` flag)
66. //!
67. //! Add `errno` to the flags field to capture the platform error code
68. //! immediately after the call (before any other code can overwrite it).
69. //! The captured value is available via [`Invocation::last_errno`], which
70. //! returns `Some(n)` when the flag is set and `None` otherwise.
71. //!
72. //! ```no_run
73. //! use dyncall::DynCaller;
74. //! #[cfg(target_os = "windows")] const LIBC: &str = "msvcrt.dll";
75. //! #[cfg(target_os = "macos")]   const LIBC: &str = "libSystem.B.dylib";
76. //! #[cfg(target_os = "linux")]   const LIBC: &str = "libc.so.6";
77. //!
78. //! let def = DynCaller::define_function_by_str(
79. //!     &format!("{LIBC}|fopen|cstr,cstr|ptr|errno")
80. //! ).unwrap();
81. //! let mut inv = def.prep();
82. //! inv.push_arg(&"__no_such_file__.txt".to_string()).unwrap();
83. //! inv.push_arg(&"r".to_string()).unwrap();
84. //! let result = inv.call();
85. //! if result.as_pointer().map(|p| p.is_null()).unwrap_or(true) {
86. //!     println!("fopen failed, errno={}", inv.last_errno().unwrap());
87. //! }
88. //! ```
89. 
90. //! For struct arguments, create a [`StructValue`] from the argument's declared
91. //! type, push each field in order with [`StructValue::push_field`], then pass
92. //! the completed value into the [`Invocation`].
93. //!
94. //! ## Standard streams (`FILE *`)
95. //!
96. //! Passing `stdin`, `stdout`, or `stderr` as a `FILE *` argument is
97. //! platform-specific. The approach differs between Windows and Unix.
98. //!
99. //! ### Linux / macOS
100. //!
101. //! Open the special device nodes `/dev/stdin`, `/dev/stdout`, `/dev/stderr`
102. //! with `fopen`. The returned `ptr` can be stored in an [`ArgVal::Pointer`]
103. //! and passed to any subsequent `FILE *` parameter:
104. //!
105. //! ```no_run
106. //! use dyncall::{DynCaller, ArgVal};
107. //! #[cfg(target_os = "linux")]  const LIBC: &str = "libc.so.6";
108. //! #[cfg(target_os = "macos")]  const LIBC: &str = "libSystem.B.dylib";
109. //! # #[cfg(not(any(target_os = "linux", target_os = "macos")))] const LIBC: &str = "";
110. //!
111. //! let fopen = DynCaller::define_function_by_str(&format!("{LIBC}|fopen|cstr,cstr|ptr|")).unwrap();
112. //! let mut inv = fopen.prep();
113. //! inv.push_arg(&"/dev/stderr".to_string()).unwrap();
114. //! inv.push_arg(&"w".to_string()).unwrap();
115. //! let stderr_fp = *inv.call().as_pointer().unwrap();
116. //!
117. //! let fputs = DynCaller::define_function_by_str(&format!("{LIBC}|fputs|cstr,ptr|i32|")).unwrap();
118. //! let mut inv = fputs.prep();
119. //! inv.push_arg(&"hello from dyncall\n".to_string()).unwrap();
120. //! inv.push_arg(&ArgVal::Pointer(stderr_fp)).unwrap();
121. //! inv.call();
122. //! ```
123. //!
124. //! ### Windows
125. //!
126. //! Windows has multiple C runtimes (`msvcrt.dll`, `ucrtbase.dll`, …), each
127. //! with its own `FILE` table. A `FILE *` from one CRT **cannot** be used with
128. //! functions from a different CRT — the call silently fails.
129. //!
130. //! Use `__acrt_iob_func(n)` from `ucrtbase.dll` to get a standard stream
131. //! handle (0 = stdin, 1 = stdout, 2 = stderr), then call I/O functions from
132. //! the **same** `ucrtbase.dll`:
133. //!
134. //! ```no_run
135. //! use dyncall::{DynCaller, ArgVal};
136. //!
137. //! let iob = DynCaller::define_function_by_str("ucrtbase.dll|__acrt_iob_func|u32|ptr|").unwrap();
138. //! let mut inv = iob.prep();
139. //! inv.push_arg(&2u32).unwrap(); // 2 = stderr
140. //! let stderr_fp = *inv.call().as_pointer().unwrap();
141. //!
142. //! let fputs = DynCaller::define_function_by_str("ucrtbase.dll|fputs|cstr,ptr|i32|").unwrap();
143. //! let mut inv = fputs.prep();
144. //! inv.push_arg(&"hello from dyncall\n".to_string()).unwrap();
145. //! inv.push_arg(&ArgVal::Pointer(stderr_fp)).unwrap();
146. //! inv.call();
147. //! ```
148. //!
149. //! Note: `ucrtbase.dll` does **not** export `printf`, `fprintf`, `sscanf`, or
150. //! `mktime`. Use `msvcrt.dll` for those; use `ucrtbase.dll` only for calls
151. //! that accept or return `FILE *`.
