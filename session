328.     let at = at.trim();
329.     if let Some(rest) = at.strip_prefix('*') {
330.         return Ok(ArgType::Pointer(Box::new(parse_arg_type(rest)?)));
331.     }
332.     if at.starts_with('{') {
333.         return Ok(ArgType::Struct(parse_struct_type(at)?));
334.     }
335. 
336.     let (parsed_arg, qualifier) = parse_def(at);
337.     Ok(match parsed_arg.trim() {
338.         "u8" | "i8" => ArgType::Char,
339.         "u16" => ArgType::U16,
340.         "i16" => ArgType::I16,
341.         "u32" => ArgType::U32,
342.         "i32" => ArgType::I32,
343.         "u64" => ArgType::U64,
344.         "i64" => ArgType::I64,
345.         "f32" => ArgType::F32,
346.         "f64" => ArgType::F64,
347.         "ptr" => ArgType::OpaquePointer,
348.         "cstr" => ArgType::CString,
349.         "ocstr" => ArgType::OCString(parse_length_def(qualifier)?),
350.         "obuff" => ArgType::OByteBuffer(parse_length_def(qualifier)?),
351.         "buff" => ArgType::ByteBuffer,
